/// claude-push-guard Taskfile (pkfire).
///
/// kawaz/* 標準: VCS 抽象 / 翻訳ペア / migrate / semver gate は
/// [kawaz/pkf-tasks](https://github.com/kawaz/pkf-tasks) 由来。本ファイルは
/// shell + JSON manifest だけのプラグインなので、lint/test/push に絞った構造。
///
/// **初回 push の例外**: `checkVersionBumped` は `compareRefCmd = "echo main@origin"`
/// で main@origin と比較する。初回 push 時は main@origin が無いため deps に
/// 含めていない。GitHub に push し main@origin が確立した後、別 change で
/// push deps に追加する（docs/issue/ に TODO あり）。
amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.7.0#/Taskfile.pkl"

import "package://pkg.pkl-lang.org/github.com/kawaz/pkf-tasks/pkf-tasks@2.2.2#/all.pkl" as kawaz

// ---------- atomic (lint / test) ----------

local lintShell: Task = new {
  name = "lint:shell"
  description = "bash -n on hooks/*.sh"
  visibility = "internal"
  inputs {
    "hooks/*.sh"
    "tests/*.sh"
  }
  cmd =
    """
    set -euo pipefail
    for f in hooks/*.sh tests/*.sh; do
      [ -f "$f" ] || continue
      bash -n "$f"
    done
    """
}

local lintJson: Task = new {
  name = "lint:json"
  description = "jq . (JSON validity) on plugin/marketplace/hooks manifests"
  visibility = "internal"
  inputs {
    ".claude-plugin/*.json"
    "hooks/*.json"
  }
  cmd =
    """
    set -euo pipefail
    for f in .claude-plugin/*.json hooks/*.json; do
      [ -f "$f" ] || continue
      jq . "$f" > /dev/null
    done
    """
}

local lintManifest: Task = new {
  name = "lint:manifest"
  description = "claude plugin validate (marketplace manifest schema)"
  visibility = "internal"
  inputs {
    ".claude-plugin/*.json"
    "hooks/*.json"
  }
  cmd = "claude plugin validate ."
}

local lintVersionSync: Task = new {
  name = "lint:version-sync"
  description = "plugin.json と marketplace.json の version 一致確認"
  visibility = "internal"
  inputs {
    ".claude-plugin/plugin.json"
    ".claude-plugin/marketplace.json"
  }
  cmd =
    #"""
    set -euo pipefail
    pv=$(jq -r '.version' .claude-plugin/plugin.json)
    mv=$(jq -r '.metadata.version' .claude-plugin/marketplace.json)
    if [ "$pv" != "$mv" ]; then
      echo "ERROR: plugin.json version ($pv) != marketplace.json metadata.version ($mv)" >&2
      exit 1
    fi
    """#
}

// pkf-tasks v2.0.0 で library export から外れたので inline (bump-semver と同様)
local lintPkl: Task = new {
  name = "lint:pkl"
  description = "pkl format -w"
  visibility = "internal"
  inputs {
    "**/*.pkl"
    "**/PklProject"
    "**/PklProject.deps.json"
  }
  cmd =
    """
    set -euo pipefail
    pkl format -w . >/dev/null
    """
}

local lint: Task = new {
  name = "lint"
  description = "lint:shell + lint:json + lint:manifest + lint:version-sync + lint:pkl"
  cache = false
  deps { lintShell; lintJson; lintManifest; lintVersionSync; lintPkl }
  cmd = ":" // umbrella noop
}

local test: Task = new {
  name = "test"
  description = "push-guard.sh integration test (12 cases)"
  inputs {
    "hooks/*.sh"
    "tests/*.sh"
  }
  deps { lint }
  cmd = "bash tests/push-guard.test.sh"
}

local ci: Task = new {
  name = "ci"
  description = "lint + test"
  cache = false
  deps { lint; test }
  cmd = ":"
}

// ---------- gates ----------

// 初回 push 後に push deps へ追加する (docs/issue/ にフォローアップ起票済)
local checkVersionBumped: Task =
  (kawaz.semver.checkBumped) {
    compareRefCmd = "echo main@origin"
    triggerPaths = List("hooks/", ".claude-plugin/")
    versionFiles = List(".claude-plugin/plugin.json")
    taskName = "semver:check-version-bumped"
  }.check

// ---------- release flow ----------

local bumpVersion: Task = new {
  name = "bump-version"
  description = "bump version file(s) for Release (plugin.json + marketplace.json を同期)"
  cache = false
  deps { kawaz.vcs.ensureClean }
  params {
    new Param {
      name = "level"
      type = "enum"
      choices { "patch"; "minor"; "major" }
      default = "patch"
      description = "semver bump level"
    }
  }
  // bump-semver は plugin.json (top-level .version) を扱える。
  // marketplace.json は .metadata.version で nested なので jq で plugin.json に揃える。
  cmd =
    #"""
    new_version=$(bump-semver "$LEVEL" .claude-plugin/plugin.json --write --no-hint)
    jq --arg v "$new_version" '.metadata.version = $v' .claude-plugin/marketplace.json \
      > .claude-plugin/marketplace.json.tmp \
      && mv .claude-plugin/marketplace.json.tmp .claude-plugin/marketplace.json
    jj commit -m "Release v${new_version}"
    """#
}

local push: Task = (kawaz.vcs.push) {
  name = "push"
  description = "push with some checks"
  deps {
    ci
    kawaz.docs.checkTranslations
    // checkVersionBumped       // 初回 push 後に有効化 (docs/issue/ 参照)
    kawaz.migrate.checkPkfTasks
    // kawaz.migrate.checkPkfire  // pkfire 0.10.0 への migrate が破壊的 (DR 必要、docs/issue/ 参照)
  }
}

// ---------- main entries (宣言順 = pkf list --unsorted 表示順) ----------

local default: Task = new {
  name = "default"
  description = "show task list"
  cache = false
  cmd = "pkf list --unsorted"
}

local list: Task = new {
  name = "list"
  description = "list recipes (order matters)"
  cache = false
  cmd = "pkf list --unsorted"
}

// ---------- task registry ----------

tasks {
  default
  list
  test
  push
  bumpVersion
  ci
  lint
  lintShell
  lintJson
  lintManifest
  lintVersionSync
  lintPkl
  ...kawaz.vcs.allTasks
  ...kawaz.docs.allTasks
  checkVersionBumped
  kawaz.semver.compare
  ...kawaz.migrate.allTasks
}
